# Unity generated content
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
# Generated by Assets > Update UIElements Schema; regenerate locally instead of committing.
/NK/UIElementsSchema/

# IDE generated content
.vs/
.idea/
.vscode/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity/Plastic local metadata
.plastic/
ignore.conf

# Local tools and package caches
.tools/
.packages/

# Unity-generated IDE files (server project files are source and must be tracked)
/NK/*.csproj
/NK/*.sln

# Local configuration and secrets
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.pem
*.key

# Build and test outputs
bin/
TestResults/
coverage/
artifacts/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Scratch Unity projects used for isolated experiments; NK/ is the formal client.
/My project/
/Test/

# Login/lobby background videos stay outside the repository for now; see Q-014 in
# NARAKA_待确认问题.md. The .meta is ignored too so no reference is committed without the file.
/NK/Assets/Game/Art/UI/Backgrounds/*.mp4
/NK/Assets/Game/Art/UI/Backgrounds/*.mp4.meta

# The High Elves pack is no longer excluded. Map01_Task is the formal task scene and
# references 156 GUIDs into this directory, so excluding it made the scene impossible to
# reproduce from a clean checkout - it would open as a field of Missing Prefabs.
# The user authorised committing it on 2026-10-06. Only the dependency closure of
# Map01_Task plus the source scene is tracked, not the whole 1.4 GB pack; the closure is
# generated by NARAKA/Setup/Generate P2.3 Scene Dependency Manifest and listed in
# Docs/Scenes/p23-high-elves-dependencies.txt.

# Accidental root-level runtime logs are local diagnostics, never release inputs.
/access_*.log
/error_*.log

# Unity PlayMode test framework temp scenes. It creates these per run and does not
# always clean them up, so they must never reach a commit.
NK/Assets/InitTestScene*.unity
NK/Assets/InitTestScene*.unity.meta
