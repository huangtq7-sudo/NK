# Unity generated content
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
# Generated by Assets > Update UIElements Schema; regenerate locally instead of committing.
/NK/UIElementsSchema/

# IDE generated content
.vs/
.idea/
.vscode/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity/Plastic local metadata
.plastic/
ignore.conf

# Local tools and package caches
.tools/
.packages/

# Unity-generated IDE files (server project files are source and must be tracked)
/NK/*.csproj
/NK/*.sln

# Local configuration and secrets
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.pem
*.key

# Build and test outputs
bin/
TestResults/
coverage/
artifacts/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Scratch Unity projects used for isolated experiments; NK/ is the formal client.
/My project/
/Test/

# Login/lobby background videos stay outside the repository for now; see Q-014 in
# NARAKA_待确认问题.md. The .meta is ignored too so no reference is committed without the file.
/NK/Assets/Game/Art/UI/Backgrounds/*.mp4
/NK/Assets/Game/Art/UI/Backgrounds/*.mp4.meta

# Third-party character art remains local until its license and P2/P4 import scope are reviewed.
# Keep both the folder and its adjacent Unity meta out of the P1 release commit without moving them.
/NK/Assets/Aquarius Fantasy - High Elves/
/NK/Assets/Aquarius Fantasy - High Elves.meta

# Accidental root-level runtime logs are local diagnostics, never release inputs.
/access_*.log
/error_*.log
