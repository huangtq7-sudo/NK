{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Naraka": {
    "LegacyNetwork": {
      "ListenPort": 9000
    },
    "Database": {
      "Provider": "MySQL",
      "ConnectionStringEnvironmentVariable": "NARAKA_MYSQL_CONNECTION_STRING"
    }
  }
}
