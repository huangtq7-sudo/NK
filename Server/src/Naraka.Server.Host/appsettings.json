{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Naraka": {
    "Bootstrap": {
      "ConfigVersion": "p0-config-1",
      "MinimumClientVersion": "0.1",
      "MaximumClientVersion": "0.1",
      "ProtocolVersion": "LegacyNetworkV1"
    },
    "LegacyNetwork": {
      "ListenAddress": "127.0.0.1",
      "ListenPort": 8011
    },
    "Database": {
      "Provider": "MySQL",
      "ConnectionStringEnvironmentVariable": "NARAKA_MYSQL_CONNECTION_STRING"
    }
  }
}
