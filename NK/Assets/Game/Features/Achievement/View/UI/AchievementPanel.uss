/* 成就与账号等级奖励界面。只使用 Unity 2021.3 支持的 USS 属性；
   选择器统一以 achv- 前缀限定，不污染同一个 UIDocument 下的其它面板。 */

.achv-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.achv-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 10, 0.66);
}

.achv-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.achv-close {
    position: absolute;
    right: 96px;
    top: 56px;
    width: 56px;
    height: 56px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../../../../Art/UI/Button/ui_button_close_v1_transparent_256x256.png");
    -unity-background-scale-mode: scale-to-fit;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.achv-close:hover {
    opacity: 0.82;
}

.achv-tabs {
    position: absolute;
    left: 200px;
    top: 84px;
    flex-direction: row;
}

.achv-tab {
    width: 220px;
    height: 52px;
    margin-right: 16px;
    font-size: 20px;
    color: rgb(226, 214, 188);
    background-color: rgba(30, 34, 44, 0.9);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(120, 104, 72, 0.6);
    border-right-color: rgba(120, 104, 72, 0.6);
    border-top-color: rgba(120, 104, 72, 0.6);
    border-bottom-color: rgba(120, 104, 72, 0.6);
}

.achv-tab--selected {
    color: rgb(28, 24, 18);
    background-color: rgb(214, 180, 106);
}

.achv-summary {
    position: absolute;
    left: 200px;
    right: 200px;
    top: 152px;
    height: 76px;
}

/* 两条互不相干的经验线并排显示：账号经验只来自任务，成就经验只来自成就。 */
.achv-summary-line {
    font-size: 20px;
    color: rgb(222, 210, 184);
    margin-bottom: 4px;
}

.achv-categories {
    position: absolute;
    left: 200px;
    top: 236px;
    flex-direction: row;
}

.achv-category {
    width: 156px;
    height: 44px;
    margin-right: 12px;
    font-size: 18px;
    color: rgb(220, 210, 186);
    background-color: rgba(30, 34, 44, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 104, 72, 0.6);
    border-right-color: rgba(120, 104, 72, 0.6);
    border-top-color: rgba(120, 104, 72, 0.6);
    border-bottom-color: rgba(120, 104, 72, 0.6);
}

.achv-category--selected {
    color: rgb(28, 24, 18);
    background-color: rgb(196, 172, 116);
}

.achv-scroll {
    position: absolute;
    left: 200px;
    right: 200px;
    top: 296px;
    bottom: 96px;
}

.achv-list {
    flex-direction: column;
}

.achv-row {
    height: 92px;
    margin-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(26, 30, 40, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(120, 104, 72, 0.6);
    border-right-color: rgba(120, 104, 72, 0.6);
    border-top-color: rgba(120, 104, 72, 0.6);
    border-bottom-color: rgba(120, 104, 72, 0.6);
}

.achv-row--claimable {
    border-left-color: rgb(226, 186, 96);
    border-right-color: rgb(226, 186, 96);
    border-top-color: rgb(226, 186, 96);
    border-bottom-color: rgb(226, 186, 96);
}

.achv-row--claimed {
    opacity: 0.55;
}

/* 事件源尚未接入（等待 P2/P3）的成就整体压暗，避免玩家以为进度卡住了。 */
.achv-row--inactive {
    opacity: 0.42;
}

.achv-row-text {
    flex-grow: 1;
    flex-direction: column;
}

.achv-row-title {
    font-size: 20px;
    color: rgb(238, 228, 204);
}

.achv-row-desc {
    margin-top: 4px;
    font-size: 15px;
    color: rgb(190, 180, 158);
    white-space: normal;
}

.achv-row-progress-track {
    margin-top: 8px;
    width: 320px;
    height: 10px;
    background-color: rgba(60, 56, 48, 0.9);
}

.achv-row-progress-fill {
    height: 10px;
    background-color: rgb(198, 164, 96);
}

.achv-row-progress-label {
    margin-top: 4px;
    font-size: 14px;
    color: rgb(176, 166, 146);
}

.achv-row-reward {
    width: 220px;
    font-size: 16px;
    color: rgb(206, 194, 168);
    white-space: normal;
}

.achv-row-button {
    width: 132px;
    height: 44px;
    font-size: 17px;
    color: rgb(28, 24, 18);
    background-color: rgb(214, 180, 106);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.achv-row-button:disabled {
    opacity: 0.45;
}

.achv-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 420px;
    font-size: 22px;
    color: rgb(198, 188, 166);
    -unity-text-align: middle-center;
}

.achv-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 44px;
    font-size: 20px;
    color: rgb(228, 168, 148);
    -unity-text-align: middle-center;
    white-space: normal;
}
