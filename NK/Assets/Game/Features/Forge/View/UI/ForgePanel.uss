/* 锻造界面。只使用 Unity 2021.3 支持的 USS 属性；
   选择器统一以 forge- 前缀限定，不污染同一个 UIDocument 下的其它面板。 */

.forge-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.forge-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 10, 0.66);
}

.forge-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.forge-close {
    position: absolute;
    right: 96px;
    top: 56px;
    width: 56px;
    height: 56px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../../../../Art/UI/Button/ui_button_close_v1_transparent_256x256.png");
    -unity-background-scale-mode: scale-to-fit;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.forge-close:hover {
    opacity: 0.82;
}

.forge-top-left {
    position: absolute;
    left: 160px;
    top: 160px;
    width: 640px;
    align-items: center;
}

.forge-weapon-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.forge-arrow {
    width: 64px;
    height: 108px;
    font-size: 38px;
    color: rgb(228, 205, 150);
    background-color: rgba(20, 24, 32, 0.55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(196, 164, 96, 0.5);
    border-right-color: rgba(196, 164, 96, 0.5);
    border-top-color: rgba(196, 164, 96, 0.5);
    border-bottom-color: rgba(196, 164, 96, 0.5);
}

.forge-arrow:hover {
    background-color: rgba(46, 52, 66, 0.72);
}

.forge-arrow:disabled {
    opacity: 0.35;
}

.forge-weapon-icon {
    width: 320px;
    height: 320px;
    -unity-background-scale-mode: scale-to-fit;
}

.forge-weapon-name {
    font-size: 40px;
    letter-spacing: 6px;
    color: rgb(228, 205, 150);
    -unity-font-style: bold;
}

.forge-top-right {
    position: absolute;
    right: 160px;
    top: 180px;
    width: 700px;
    background-color: rgba(12, 15, 22, 0.68);
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 28px;
    padding-bottom: 28px;
}

.forge-level {
    font-size: 30px;
    color: rgb(214, 210, 200);
    margin-bottom: 20px;
}

/* 强化预览："攻击力 68 → 75"。左右两个数值都来自配置，不做任何本地推算。 */
.forge-preview {
    font-size: 40px;
    color: rgb(226, 200, 130);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.forge-preview-sub {
    font-size: 24px;
    color: rgb(196, 194, 188);
}

.forge-max-level {
    font-size: 26px;
    color: rgb(168, 208, 176);
    margin-top: 16px;
}

.forge-bottom {
    position: absolute;
    left: 160px;
    right: 160px;
    bottom: 110px;
    background-color: rgba(12, 15, 22, 0.68);
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.forge-cost-title {
    font-size: 26px;
    color: rgb(228, 205, 150);
    margin-bottom: 16px;
}

.forge-cost-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.forge-cost-entry {
    font-size: 22px;
    color: rgb(206, 200, 186);
    margin-right: 36px;
    margin-bottom: 8px;
}

/* 材料不足的条目标红，玩家一眼就能看出缺什么。 */
.forge-cost-entry--missing {
    color: rgb(226, 138, 128);
}

.forge-success-rate {
    font-size: 24px;
    color: rgb(168, 208, 176);
    margin-bottom: 20px;
}

.forge-upgrade {
    width: 320px;
    height: 84px;
    font-size: 30px;
    letter-spacing: 6px;
    color: rgb(28, 24, 18);
    background-color: rgb(206, 172, 96);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.forge-upgrade:hover {
    background-color: rgb(224, 192, 118);
}

.forge-upgrade:disabled {
    background-color: rgba(120, 116, 106, 0.75);
    color: rgba(238, 234, 226, 0.7);
}

.forge-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 50px;
    font-size: 24px;
    color: rgb(226, 138, 128);
    -unity-text-align: middle-center;
}
