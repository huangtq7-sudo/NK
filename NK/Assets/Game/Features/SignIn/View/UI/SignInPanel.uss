/* 签到界面。只使用 Unity 2021.3 支持的 USS 属性；
   选择器统一以 signin- 前缀限定，不污染同一个 UIDocument 下的其它面板。 */

.signin-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.signin-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 10, 0.66);
}

.signin-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.signin-close {
    position: absolute;
    right: 96px;
    top: 56px;
    width: 56px;
    height: 56px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../../../../Art/UI/Button/ui_button_close_v1_transparent_256x256.png");
    -unity-background-scale-mode: scale-to-fit;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.signin-close:hover {
    opacity: 0.82;
}

.signin-header {
    position: absolute;
    left: 220px;
    right: 220px;
    top: 96px;
    height: 132px;
    align-items: center;
}

.signin-title {
    font-size: 40px;
    color: rgb(244, 232, 206);
    -unity-font-style: bold;
}

.signin-streak {
    margin-top: 12px;
    font-size: 22px;
    color: rgb(216, 200, 168);
}

.signin-makeup-card {
    margin-top: 6px;
    font-size: 18px;
    color: rgb(178, 166, 142);
}

.signin-day-grid {
    position: absolute;
    left: 220px;
    right: 220px;
    top: 244px;
    height: 300px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.signin-day {
    width: 168px;
    height: 138px;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 8px;
    margin-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(26, 30, 40, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(120, 104, 72, 0.7);
    border-right-color: rgba(120, 104, 72, 0.7);
    border-top-color: rgba(120, 104, 72, 0.7);
    border-bottom-color: rgba(120, 104, 72, 0.7);
}

/* 今天可领：高亮边框。 */
.signin-day--claimable {
    border-left-color: rgb(226, 186, 96);
    border-right-color: rgb(226, 186, 96);
    border-top-color: rgb(226, 186, 96);
    border-bottom-color: rgb(226, 186, 96);
}

/* 已领取：整体压暗，与"漏签"在视觉上分开。 */
.signin-day--claimed {
    opacity: 0.55;
}

/* 漏签且还能补：偏红的边框提示玩家可以补签。 */
.signin-day--missed {
    border-left-color: rgb(178, 92, 82);
    border-right-color: rgb(178, 92, 82);
    border-top-color: rgb(178, 92, 82);
    border-bottom-color: rgb(178, 92, 82);
}

/* 漏签且补签次数已用完：不可挽回，直接压到最暗。 */
.signin-day--locked {
    opacity: 0.38;
}

.signin-day-title {
    font-size: 20px;
    color: rgb(238, 228, 204);
    -unity-font-style: bold;
}

.signin-day-reward {
    margin-top: 8px;
    font-size: 16px;
    color: rgb(206, 194, 168);
    white-space: normal;
    -unity-text-align: middle-center;
}

.signin-day-state {
    margin-top: 6px;
    font-size: 15px;
    color: rgb(168, 158, 136);
}

.signin-milestones {
    position: absolute;
    left: 220px;
    right: 220px;
    top: 560px;
    height: 190px;
}

.signin-milestone-title {
    font-size: 22px;
    color: rgb(232, 218, 190);
    -unity-font-style: bold;
}

.signin-milestone-list {
    margin-top: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.signin-milestone {
    width: 236px;
    height: 118px;
    margin-right: 14px;
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(26, 30, 40, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(120, 104, 72, 0.7);
    border-right-color: rgba(120, 104, 72, 0.7);
    border-top-color: rgba(120, 104, 72, 0.7);
    border-bottom-color: rgba(120, 104, 72, 0.7);
}

.signin-milestone--claimable {
    border-left-color: rgb(226, 186, 96);
    border-right-color: rgb(226, 186, 96);
    border-top-color: rgb(226, 186, 96);
    border-bottom-color: rgb(226, 186, 96);
}

.signin-milestone--claimed {
    opacity: 0.55;
}

.signin-milestone-label {
    font-size: 18px;
    color: rgb(234, 224, 200);
}

.signin-milestone-reward {
    margin-top: 6px;
    font-size: 15px;
    color: rgb(200, 190, 166);
    white-space: normal;
}

.signin-milestone-button {
    margin-top: 8px;
    height: 34px;
    font-size: 15px;
    color: rgb(28, 24, 18);
    background-color: rgb(214, 180, 106);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.signin-milestone-button:disabled {
    opacity: 0.45;
}

.signin-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 92px;
    flex-direction: row;
    justify-content: center;
}

.signin-action {
    width: 220px;
    height: 60px;
    margin-left: 18px;
    margin-right: 18px;
    font-size: 22px;
    color: rgb(28, 24, 18);
    background-color: rgb(214, 180, 106);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.signin-action:hover {
    opacity: 0.9;
}

.signin-action:disabled {
    opacity: 0.45;
}

.signin-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 380px;
    font-size: 22px;
    color: rgb(198, 188, 166);
    -unity-text-align: middle-center;
}

.signin-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 44px;
    font-size: 20px;
    color: rgb(228, 168, 148);
    -unity-text-align: middle-center;
    white-space: normal;
}
