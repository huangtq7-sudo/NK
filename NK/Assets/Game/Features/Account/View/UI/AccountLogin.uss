/* 正式登录界面样式。仅使用 Unity 2021.3 UI Toolkit 支持的 USS 属性。
   所有选择器都以 account- 前缀限定，避免影响同一 UIDocument 下的
   ConfigVersionOverlay 与 LobbyPanel。 */

.account-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

/* 背景：1920x1080正式静态底图。标题已烘焙在图内，卡片不再重复显示标题。
   scale-and-crop 保证非16:9窗口下填满而不变形；background-color 只作为加载失败兜底。 */
.account-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 11, 17);
    background-image: url("../../../../Art/UI/Backgrounds/AccountLoginBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.account-panel {
    width: 460px;
    margin-bottom: 170px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 42px;
    padding-bottom: 38px;
    background-color: rgba(12, 17, 26, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(217, 180, 95, 0.28);
    border-right-color: rgba(217, 180, 95, 0.28);
    border-top-color: rgba(217, 180, 95, 0.28);
    border-bottom-color: rgba(217, 180, 95, 0.28);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.account-panel__subtitle {
    margin-left: 0;
    margin-right: 0;
    font-size: 22px;
    letter-spacing: 6px;
    color: rgb(217, 180, 95);
    -unity-font-style: bold;
}

.account-panel__rule {
    height: 1px;
    margin-top: 20px;
    margin-bottom: 28px;
    background-color: rgba(217, 180, 95, 0.32);
}

.account-field__caption {
    margin-bottom: 7px;
    margin-left: 0;
    margin-right: 0;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(176, 184, 196);
}

.account-field {
    margin-top: 0;
    margin-bottom: 18px;
    margin-left: 0;
    margin-right: 0;
    color: rgb(230, 232, 236);
}

.account-field .unity-base-text-field__input {
    flex-grow: 1;
    height: 42px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 16px;
    color: rgb(230, 232, 236);
    background-color: rgb(18, 24, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 132, 150, 0.45);
    border-right-color: rgba(120, 132, 150, 0.45);
    border-top-color: rgba(120, 132, 150, 0.45);
    border-bottom-color: rgba(120, 132, 150, 0.45);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.account-field .unity-base-text-field__input:hover {
    border-left-color: rgba(217, 180, 95, 0.45);
    border-right-color: rgba(217, 180, 95, 0.45);
    border-top-color: rgba(217, 180, 95, 0.45);
    border-bottom-color: rgba(217, 180, 95, 0.45);
}

.account-field .unity-base-text-field__input:focus {
    background-color: rgb(22, 29, 42);
    border-left-color: rgb(217, 180, 95);
    border-right-color: rgb(217, 180, 95);
    border-top-color: rgb(217, 180, 95);
    border-bottom-color: rgb(217, 180, 95);
}

.account-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 12px;
}

.account-button {
    width: 186px;
    height: 46px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 18px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.account-button--secondary {
    color: rgb(186, 194, 206);
    background-color: rgba(255, 255, 255, 0.04);
    border-left-color: rgba(140, 152, 170, 0.5);
    border-right-color: rgba(140, 152, 170, 0.5);
    border-top-color: rgba(140, 152, 170, 0.5);
    border-bottom-color: rgba(140, 152, 170, 0.5);
}

.account-button--secondary:hover {
    color: rgb(226, 231, 238);
    background-color: rgba(255, 255, 255, 0.09);
    border-left-color: rgba(186, 196, 212, 0.75);
    border-right-color: rgba(186, 196, 212, 0.75);
    border-top-color: rgba(186, 196, 212, 0.75);
    border-bottom-color: rgba(186, 196, 212, 0.75);
}

.account-button--primary {
    color: rgb(240, 226, 190);
    background-color: rgba(217, 180, 95, 0.18);
    border-left-color: rgb(217, 180, 95);
    border-right-color: rgb(217, 180, 95);
    border-top-color: rgb(217, 180, 95);
    border-bottom-color: rgb(217, 180, 95);
}

.account-button--primary:hover {
    background-color: rgba(217, 180, 95, 0.32);
}

.account-button:active {
    background-color: rgba(217, 180, 95, 0.42);
}

.account-status {
    margin-top: 24px;
    margin-left: 0;
    margin-right: 0;
    min-height: 44px;
    font-size: 15px;
    white-space: normal;
    color: rgb(176, 184, 196);
}

.account-panel--busy .account-status {
    color: rgb(217, 180, 95);
}

.account-panel--failed .account-status {
    color: rgb(224, 150, 122);
}
