* text=auto
*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
# Unity-generated .meta files and vendored upstream packages may preserve harmless
# trailing spaces; exclude them from first-party whitespace diagnostics.
*.meta -whitespace
NK/Packages/com.cysharp.messagepipe/** -whitespace
NK/Packages/com.cysharp.messagepipe.vcontainer/** -whitespace
NK/Packages/com.cysharp.r3/** -whitespace
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.fbx binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.unitypackage binary
