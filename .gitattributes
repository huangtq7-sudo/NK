* text=auto
*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
# Unity writes trailing spaces on empty-value lines in generated scene YAML, and the
# Editor restores them on every save. Keep the newline convention, drop the useless
# trailing-whitespace warning rather than fighting a generator over 50k lines.
*.unity text eol=lf -whitespace
*.prefab text eol=lf
*.asset text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.meta text eol=lf
# Unity-generated .meta files and vendored upstream packages may preserve harmless
# trailing spaces; exclude them from first-party whitespace diagnostics.
*.meta -whitespace
NK/Packages/com.cysharp.messagepipe/** -whitespace
NK/Packages/com.cysharp.messagepipe.vcontainer/** -whitespace
NK/Packages/com.cysharp.r3/** -whitespace
# Same reasoning for vendored third-party art packs: their own source files carry
# trailing spaces, they are read-only to us, and flagging them buries real findings.
# Patterns with spaces must be quoted here, or Git parses the rest of the line as
# attribute names and warns on every command.
"NK/Assets/Aquarius Fantasy - High Elves/**" -whitespace
NK/Assets/PureNature/** -whitespace
"NK/Assets/Polygonal Creatures Pack/**" -whitespace
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg binary
*.jpeg binary
*.webp binary
*.fbx filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.wav binary
*.mp3 binary
*.mp4 binary
*.exr filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# P1-owned Unity UI bitmaps are required to reproduce the current layouts but are too large
# for ordinary Git history. Their Unity .meta files remain normal text.
NK/Assets/Game/Art/**/*.png filter=lfs diff=lfs merge=lfs -text

# The project-owned combat scene is derived from the Pure Nature demo scene and is
# therefore the same order of magnitude (~39 MB). It is a text scene, but far too large
# for ordinary Git history, so it follows the same LFS rule as its source.
NK/Assets/Game/Scenes/World/Map02_Combat.unity filter=lfs diff=lfs merge=lfs -text
# Its baked NavMesh covers the whole 1000x1000 terrain and is ~33 MB of binary data.
NK/Assets/Game/Scenes/World/Map02_Combat/NavMesh.asset filter=lfs diff=lfs merge=lfs -text

# Large, vendored PureNature scene payloads are immutable source assets and are
# stored in LFS without changing Unity's scene or terrain contents.
NK/Assets/PureNature/Scenes/Scene_Demo/Scene_Demo.unity filter=lfs diff=lfs merge=lfs -text
NK/Assets/PureNature/Scenes/Scene_Demo/Scene_Demo_Terrain.asset filter=lfs diff=lfs merge=lfs -text
